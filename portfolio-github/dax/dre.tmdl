		measure 'HTML DRE Cartões' = ```
			VAR xRL = [Receita Líquida]
			VAR vRF1 = CALCULATE([Resultado Financeiro], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) <= 6)))
			VAR vRF2 = CALCULATE([Resultado Financeiro], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) > 6)))
			VAR vRFT = [Resultado Financeiro]
			VAR _afRF1 = ABS(vRF1)
			VAR fRF1 = IF(vRF1 < 0, "-", "") & "R$ " & IF(_afRF1 >= 1000000, FORMAT(_afRF1 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afRF1 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afRF2 = ABS(vRF2)
			VAR fRF2 = IF(vRF2 < 0, "-", "") & "R$ " & IF(_afRF2 >= 1000000, FORMAT(_afRF2 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afRF2 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afRFT = ABS(vRFT)
			VAR fRFT = IF(vRFT < 0, "-", "") & "R$ " & IF(_afRFT >= 1000000, FORMAT(_afRFT / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afRFT / 1000, "#,0", "pt-BR") & " mil")
			VAR tRF = FORMAT(DIVIDE(vRFT, xRL), "0.0%", "pt-BR") & " RL"
			VAR _mRF = MAX(ABS(vRF1), ABS(vRF2))
			VAR wRF1 = INT(DIVIDE(ABS(vRF1), _mRF) * 100)
			VAR wRF2 = INT(DIVIDE(ABS(vRF2), _mRF) * 100)
			VAR cRF = IF(vRFT >= 0, "#C6FF00", "#FF3B5C")
			VAR vLAIR1 = CALCULATE([LAIR], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) <= 6)))
			VAR vLAIR2 = CALCULATE([LAIR], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) > 6)))
			VAR vLAIRT = [LAIR]
			VAR _afLAIR1 = ABS(vLAIR1)
			VAR fLAIR1 = IF(vLAIR1 < 0, "-", "") & "R$ " & IF(_afLAIR1 >= 1000000, FORMAT(_afLAIR1 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afLAIR1 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afLAIR2 = ABS(vLAIR2)
			VAR fLAIR2 = IF(vLAIR2 < 0, "-", "") & "R$ " & IF(_afLAIR2 >= 1000000, FORMAT(_afLAIR2 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afLAIR2 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afLAIRT = ABS(vLAIRT)
			VAR fLAIRT = IF(vLAIRT < 0, "-", "") & "R$ " & IF(_afLAIRT >= 1000000, FORMAT(_afLAIRT / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afLAIRT / 1000, "#,0", "pt-BR") & " mil")
			VAR tLAIR = FORMAT(DIVIDE(vLAIRT, xRL), "0.0%", "pt-BR") & " RL"
			VAR _mLAIR = MAX(ABS(vLAIR1), ABS(vLAIR2))
			VAR wLAIR1 = INT(DIVIDE(ABS(vLAIR1), _mLAIR) * 100)
			VAR wLAIR2 = INT(DIVIDE(ABS(vLAIR2), _mLAIR) * 100)
			VAR cLAIR = IF(vLAIRT >= 0, "#C6FF00", "#FF3B5C")
			VAR vIR1 = CALCULATE([IRPJ e CSLL], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) <= 6)))
			VAR vIR2 = CALCULATE([IRPJ e CSLL], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) > 6)))
			VAR vIRT = [IRPJ e CSLL]
			VAR _afIR1 = ABS(vIR1)
			VAR fIR1 = IF(vIR1 < 0, "-", "") & "R$ " & IF(_afIR1 >= 1000000, FORMAT(_afIR1 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afIR1 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afIR2 = ABS(vIR2)
			VAR fIR2 = IF(vIR2 < 0, "-", "") & "R$ " & IF(_afIR2 >= 1000000, FORMAT(_afIR2 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afIR2 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afIRT = ABS(vIRT)
			VAR fIRT = IF(vIRT < 0, "-", "") & "R$ " & IF(_afIRT >= 1000000, FORMAT(_afIRT / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afIRT / 1000, "#,0", "pt-BR") & " mil")
			VAR tIR = FORMAT(DIVIDE(vIRT, xRL), "0.0%", "pt-BR") & " RL"
			VAR _mIR = MAX(ABS(vIR1), ABS(vIR2))
			VAR wIR1 = INT(DIVIDE(ABS(vIR1), _mIR) * 100)
			VAR wIR2 = INT(DIVIDE(ABS(vIR2), _mIR) * 100)
			VAR cIR = "#00B3FF"
			VAR vLL1 = CALCULATE([Lucro Líquido], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) <= 6)))
			VAR vLL2 = CALCULATE([Lucro Líquido], KEEPFILTERS(FILTER(ALL(dCalendario[Date]), MONTH(dCalendario[Date]) > 6)))
			VAR vLLT = [Lucro Líquido]
			VAR _afLL1 = ABS(vLL1)
			VAR fLL1 = IF(vLL1 < 0, "-", "") & "R$ " & IF(_afLL1 >= 1000000, FORMAT(_afLL1 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afLL1 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afLL2 = ABS(vLL2)
			VAR fLL2 = IF(vLL2 < 0, "-", "") & "R$ " & IF(_afLL2 >= 1000000, FORMAT(_afLL2 / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afLL2 / 1000, "#,0", "pt-BR") & " mil")
			VAR _afLLT = ABS(vLLT)
			VAR fLLT = IF(vLLT < 0, "-", "") & "R$ " & IF(_afLLT >= 1000000, FORMAT(_afLLT / 1000000, "#,0.0", "pt-BR") & " mi", FORMAT(_afLLT / 1000, "#,0", "pt-BR") & " mil")
			VAR tLL = FORMAT(DIVIDE(vLLT, xRL), "0.0%", "pt-BR") & " RL"
			VAR _mLL = MAX(ABS(vLL1), ABS(vLL2))
			VAR wLL1 = INT(DIVIDE(ABS(vLL1), _mLL) * 100)
			VAR wLL2 = INT(DIVIDE(ABS(vLL2), _mLL) * 100)
			VAR cLL = IF(vLLT >= 0, "#C6FF00", "#FF3B5C")
			RETURN
			"<style>html,body{margin:0;padding:0;overflow:hidden;background:transparent}.hc{display:flex;gap:12px;width:100%;height:132px;box-sizing:border-box;padding:4px;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif}.hc .c{flex:1;min-width:0;box-sizing:border-box;height:124px;padding:12px 16px;border-radius:16px;position:relative;overflow:hidden;background:linear-gradient(135deg,#FFFFFF1F,#FFFFFF08);border:1px solid #FFFFFF2E;backdrop-filter:blur(12px);box-shadow:0 0 18px #00B3FF33,inset 0 1px 0 #FFFFFF26;opacity:0;animation:hcUp 700ms ease-out forwards}.hc .c:before{content:'';position:absolute;left:0;top:0;width:100%;height:3px;background:linear-gradient(90deg,#C6FF00,#00B3FF)}.hc .t{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px;line-height:16px;letter-spacing:2px;font-weight:600;color:#9FB3C8;white-space:nowrap;overflow:hidden}.hc .t span{letter-spacing:0;font-weight:700;padding:0 8px;border:1px solid;border-radius:12px}.hc .v{font-size:30px;line-height:36px;font-weight:700;color:#FFFFFF;white-space:nowrap;text-shadow:0 0 14px #00B3FF80}.hc .s{display:flex;gap:10px;margin-top:8px}.hc .s div{flex:1;min-width:0}.hc .s p{margin:0;font-size:12px;line-height:16px;color:#9FB3C8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hc .s b{display:block;height:4px;border-radius:4px;background:#FFFFFF14;margin-top:4px;overflow:hidden}.hc .s i{display:block;height:4px;border-radius:4px;animation:hcGrow 1100ms ease-out}@keyframes hcUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}@keyframes hcGrow{from{width:0}}</style><div class='hc'><div class='c' style='animation-delay:0ms'><div class='t'>RES. FINANCEIRO<span style='color:" &
			cRF &
			";border-color:" &
			cRF &
			"'>" &
			tRF &
			"</span></div><div class='v'>" &
			fRFT &
			"</div><div class='s'><div><p>1º sem " &
			fRF1 &
			"</p><b><i style='width:" &
			wRF1 &
			"%;background:" &
			cRF &
			"'></i></b></div><div><p>2º sem " &
			fRF2 &
			"</p><b><i style='width:" &
			wRF2 &
			"%;background:#00B3FF'></i></b></div></div></div><div class='c' style='animation-delay:120ms'><div class='t'>LAIR<span style='color:" &
			cLAIR &
			";border-color:" &
			cLAIR &
			"'>" &
			tLAIR &
			"</span></div><div class='v'>" &
			fLAIRT &
