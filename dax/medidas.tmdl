createOrReplace

	table _Medidas

		measure Receita = CALCULATE(SUM(fLancamentos[Valor]), dContas[Tipo] = "Receita")
			formatString: \R\$ #,##0.00;-\R\$ #,##0.00;\R\$ #,##0.00

		measure Despesas = CALCULATE(SUM(fLancamentos[Valor]), dContas[Tipo] <> "Receita")
			formatString: \R\$ #,##0.00;-\R\$ #,##0.00;\R\$ #,##0.00

		measure Resultado = [Receita] - [Despesas]
			formatString: \R\$ #,##0.00;-\R\$ #,##0.00;\R\$ #,##0.00

		measure 'Margem %' = DIVIDE([Resultado], [Receita])
			formatString: 0.0%;-0.0%;0.0%

		measure 'Receita Orçada' = CALCULATE(SUM(fOrcamento[Valor Orçado]), dContas[Tipo] = "Receita")
			formatString: \R\$ #,##0.00;-\R\$ #,##0.00;\R\$ #,##0.00

		measure 'Despesas Orçadas' = CALCULATE(SUM(fOrcamento[Valor Orçado]), dContas[Tipo] <> "Receita")
			formatString: \R\$ #,##0.00;-\R\$ #,##0.00;\R\$ #,##0.00

		measure 'Resultado Orçado' = [Receita Orçada] - [Despesas Orçadas]
			formatString: \R\$ #,##0.00;-\R\$ #,##0.00;\R\$ #,##0.00

		measure 'Margem Orçada %' = DIVIDE([Resultado Orçado], [Receita Orçada])
			formatString: 0.0%;-0.0%;0.0%

		column Coluna
			dataType: int64
			isHidden
			isNameInferred
			isDataTypeInferred
			sourceColumn: [Coluna]
			summarizeBy: none

		partition _Medidas = calculated
			mode: import
			source = ROW("Coluna", 0)

